platform :ios, '13.0'

# Flutter's default Podfile content
target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Flutter Pod
  pod 'Flutter', :path => File.join('..', 'Flutter')

  # Add your plugin dependencies here (auto-added by Flutter)
  # Example for cloud_firestore:
  pod 'cloud_firestore', :path => File.join(File.dirname(__FILE__), '.symlinks/plugins/cloud_firestore/ios'
  
  # Other Firebase pods will be automatically added
end

# Post-install hooks (important for Flutter)
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Enable Swift support if needed
      config.build_settings['SWIFT_VERSION'] = '5.0'
      
      # Fix Xcode 12+ compatibility
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
    end
  end
end